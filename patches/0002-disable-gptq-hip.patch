@@ -33,6 +33,13 @@ namespace gptq {
 
 #if defined(USE_ROCM)
   #include <hipblas/hipblas.h>
+// ROCm does not provide an atomicAdd overload for half2; emulate it with two
+// half atomic updates.  Only used by the GPTQ path, so performance is minor.
+__device__ __forceinline__ void atomicAdd(half2* address, half2 val) {
+    atomicAdd(reinterpret_cast<half*>(address), val.x);
+    atomicAdd(reinterpret_cast<half*>(address) + 1, val.y);
+}
+
 __host__ __forceinline__ hipblasStatus_t __compat_hipblasHgemm(
     hipblasHandle_t handle, hipblasOperation_t transA,
     hipblasOperation_t transB, int m, int n, int k, const half* alpha,
